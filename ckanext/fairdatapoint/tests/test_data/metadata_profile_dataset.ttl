# A FAIR Data Point dataset record that reads differently depending on the metadata profile:
# the alternative title, hasStructuredData and the cv:contactPoint of the agent are HealthDCAT-AP
# R8 properties; the keyword with a slash is cleaned by the FAIR Data Point behaviour.

@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .

<https://fdp.example.org/dataset/profile-selection>
    a dcat:Dataset ;
    dct:title "Profile selection dataset"@en ;
    dct:description "A FAIR Data Point record that reads differently under HealthDCAT-AP R8."@en ;
    dct:identifier "profile-selection-1" ;
    dct:alternative "Another title"@en ;
    dcat:keyword "CNS/Brain"@en, "COVID-19"@en ;
    healthdcatap:hasStructuredData true ;
    healthdcatap:hdab <https://fdp.example.org/agent/hdab> .

<https://fdp.example.org/agent/hdab>
    a foaf:Agent ;
    foaf:name "Example HDAB" ;
    cv:contactPoint [
        a cv:ContactPoint ;
        cv:email "hdab@example.org" ;
        cv:contactPage <https://example.org/contact> ;
        cv:telephone "+31 20 555 0100"
    ] .
